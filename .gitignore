# Allowlist: EVERYTHING is ignored unless it is listed below on purpose.
# To publish a new file, add a "!" line for it here, then check: git add -A --dry-run
/*
!/.gitignore
!/LICENSE
!/LICENSES/
!/README.md
!/README.es.md
!/REUSE.toml
!/THIRD-PARTY.md

!/docs/
/docs/*
!/docs/modding/
/docs/modding/*
!/docs/modding/MODDING.pdf
!/docs/modding/MODDING.es.pdf
!/docs/modding/build_pdf.py
!/docs/modding/guia.css
!/docs/modding/modding.html
!/docs/modding/modding.es.html
!/docs/modding/fonts/
/docs/modding/fonts/*
!/docs/modding/fonts/FONTS.txt
!/docs/modding/fonts/Gugi-latin.woff2
!/docs/modding/fonts/Rubik-latin-400.woff2
!/docs/modding/fonts/Rubik-latin-500.woff2
!/docs/modding/fonts/Rubik-latin-700.woff2
!/docs/modding/fonts/Rubik-latin-900.woff2
!/docs/modding/fonts/PixelOperator.ttf
!/docs/modding/fonts/PixelOperator_CC0.txt
!/docs/modding/img/
/docs/modding/img/*
!/docs/modding/img/fire.svg
!/docs/modding/img/rewind-icon.png

!/launcher/
/launcher/*
!/launcher/config.xml
!/launcher/icon.png

!/retro-bauhaus/
/retro-bauhaus/*
!/retro-bauhaus/logos.js
!/retro-bauhaus/P8e/
/retro-bauhaus/P8e/*
!/retro-bauhaus/P8e/index.html
!/retro-bauhaus/P8e/p8e.css
!/retro-bauhaus/P8e/p8e.js
!/retro-bauhaus/P8e/gl.js
!/retro-bauhaus/P8e/sound.js
!/retro-bauhaus/P8e/weather.js
!/retro-bauhaus/P8e/pyp.js
!/retro-bauhaus/P8e/rates.js
!/retro-bauhaus/P8e/tizen-adapter.js
!/retro-bauhaus/P8e/diag.js
!/retro-bauhaus/P8e/data/
/retro-bauhaus/P8e/data/*
!/retro-bauhaus/P8e/data/weather-fixture.json
!/retro-bauhaus/P8e/data/weather-fixture-2.json
!/retro-bauhaus/fonts/
/retro-bauhaus/fonts/*
!/retro-bauhaus/fonts/OFL.txt
!/retro-bauhaus/fonts/PixelOperator_CC0.txt
!/retro-bauhaus/fonts/PixelOperator.ttf
!/retro-bauhaus/fonts/FunnelDisplay-Light.ttf
!/retro-bauhaus/fonts/Gugi-latin.woff2
!/retro-bauhaus/fonts/Rubik-latin-*.woff2
!/retro-bauhaus/assets/
/retro-bauhaus/assets/*
!/retro-bauhaus/assets/art/
/retro-bauhaus/assets/art/*
!/retro-bauhaus/assets/art/[0-9][0-9]-*.jpg
!/retro-bauhaus/assets/art/manifest.jsonl
!/retro-bauhaus/assets/icons/
/retro-bauhaus/assets/icons/*
!/retro-bauhaus/assets/icons/monalisa-v2.svg
!/retro-bauhaus/assets/brand/
/retro-bauhaus/assets/brand/*
!/retro-bauhaus/assets/brand/qr-portfolio.svg

!/tools/
/tools/*
!/tools/stage_tv.py
!/tools/test_stage_tv.py
!/tools/m47_check.mjs

# Never, even if a line above would let it in (the last matching rule wins)
._*
.DS_Store
*.p12
*.pfx
*.pri
*.csr
*.pem
*.cer
*.crt
*.der
*.key
*.jks
*.keystore
*.pk8
*.p7b
*.p7s
device-profile.xml
profiles.xml
author-signature.xml
signature*.xml
*.wgt
*.jsonl
!/retro-bauhaus/assets/art/manifest.jsonl
